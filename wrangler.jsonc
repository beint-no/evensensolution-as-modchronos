{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reai-store-9bd71d09ac8b4b87b22a7719893327d5",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "preview_urls": true,
  "keep_vars": true,
  "ratelimits": [{"name":"CHECKOUT_RATE_LIMIT","namespace_id":"225411","simple":{"limit":100,"period":60}}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "REAI_API_BASE_URL": "https://app.reai.no",
    "CANONICAL_HOSTNAME": "modchronos.respiro.workers.dev",
    "WATCH_CASE_PROMOTION": "true"
  },
  "previews": {
    "vars": {
      "REAI_MANAGED_PREVIEWS": "true",
      "REAI_API_BASE_URL": "https://app.reai.no",
      "CHECKOUT_ENABLED": "false",
      "WATCH_CASE_PROMOTION": "true"
    }
  },
  "account_id": "d7c5a90b75a693cc738d69f92808f451"
}
