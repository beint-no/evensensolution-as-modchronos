{
  "name": "reai-store-9bd71d09ac8b4b87b22a7719893327d5",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "REAI_API_BASE_URL": "https://app.reai.no",
    "REAI_MANAGED_PREVIEWS": "true"
  },
  "previews": {
    "vars": {
      "REAI_MANAGED_PREVIEWS": "true",
      "REAI_PREVIEW_API_BASE_URL": "https://app.reai.no",
      "REAI_API_BASE_URL": "https://app.reai.no"
    }
  }
}
